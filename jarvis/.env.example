# ---------------------------------------------------------------------------
# Supabase — banco, autenticação e RLS
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Motores de IA — configure pelo menos UM. O usuário escolhe qual usar em
# /configuracoes; a tela só oferece os motores cuja chave existe aqui.
# As chaves NUNCA vão para o banco nem para o navegador.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# PubMed (E-utilities do NCBI)
# Funciona sem chave (3 requisições/segundo). Com chave: 10/segundo.
# Grátis em https://account.ncbi.nlm.nih.gov/settings/
# E-mail e nome da ferramenta são exigidos pela política de uso do NCBI.
# ---------------------------------------------------------------------------
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=jarvis-pbl

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
